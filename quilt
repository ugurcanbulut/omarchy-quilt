#!/bin/bash

# Quilt: tile layout presets for Hyprland, driven from the Omarchy bar.
#
#   quilt set <spec>         use a layout on the active workspace: 4|8, 3|6|3:2,
#                            4:8/4, @12x12:0,0,6,12;6,0,6,12, smart, dwindle,
#                            scrolling, monocle, or off
#   quilt use <name>         use one of your presets, by its label or spec
#   quilt next | prev        cycle through the presets
#   quilt grow | shrink      widen or narrow the focused window's column
#   quilt mirror             flip the layout left to right
#   quilt main               swap the focused window into the main tile
#   quilt move <n|empty>     move the focused window to tile n, or the first empty one
#   quilt swap <a> <b>       swap the windows in tiles a and b
#   quilt target <n> [ws]    open the app launcher; the new app goes to tile n
#   quilt home [n] [app]     make tile n home to an app (default: the focused
#                            window's app and tile); "none" clears it
#   quilt homes [json]       print or replace the workspace's app homes
#   quilt edit               edit the active workspace's layout on screen
#   quilt new                draw a new layout on an empty workspace
#   quilt status             print the active workspace's layout as JSON
#   quilt area               print the active workspace's tile area as JSON
#   quilt load               load the layout engine (the bar does this itself)
#
# A spec lists column widths on a 10- or 12-column grid; ":n" splits a column
# into n equal stacked tiles, ":8/4" into tiles of those heights. "@WxH:" lists
# drawn rectangles as x,y,w,h. QUILT_WORKSPACE overrides the workspace.

set -uo pipefail

DIR=$(dirname "$(readlink -f "$0")")
ID=ugurcanbulut.quilt
SHELL_CONFIG="$HOME/.config/omarchy/shell.json"

usage() {
  awk 'NR >= 5 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0" >&2
  exit 1
}

notify() {
  if command -v notify-send >/dev/null; then
    notify-send -a Quilt "Quilt" "$1"
  else
    echo "quilt: $1" >&2
  fi
}

check_requirements() {
  local tool
  for tool in hyprctl jq; do
    command -v "$tool" >/dev/null || { notify "Missing required program: $tool"; exit 1; }
  done
  if [[ $(hyprctl dispatch 'hl.dsp.no_op()' 2>/dev/null) != ok ]]; then
    notify "Quilt needs Hyprland with the Lua config (Hyprland 0.55 or newer)"
    exit 1
  fi
}

# The active workspace, named the way the engine names it.
workspace_key() {
  if [[ -n ${QUILT_WORKSPACE:-} ]]; then
    echo "$QUILT_WORKSPACE"
    return
  fi
  hyprctl activeworkspace -j | jq -r '
    if .id > 0 then (.id | tostring)
    elif (.name | startswith("special:")) then .name
    else "name:" + .name end'
}

lua_string() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/\\\\/\\\\\\\\/g; s/'/\\\\'/g")"
}

# App homes as a Lua argument: {"2":"chromium"} -> {[2]="chromium"}, "keep"
# stays a string, anything else is nil (none).
lua_homes() {
  [[ $1 == keep ]] && { echo "'keep'"; return; }
  jq -r 'if type == "object" then "{" + ([to_entries[] | select((.key | test("^[0-9]+$")) and (.value | type == "string") and .value != "")
    | "[\(.key)]=\(.value | ascii_downcase | @json)"] | join(",")) + "}" else "nil" end' <<<"${1:-null}" 2>/dev/null || echo nil
}

# Run Lua inside Hyprland; repl prints what the code returns.
lua() {
  hyprctl repl "$1" 2>&1
}

load() {
  local result
  # The leading statement keeps hyprctl from reading the file's first
  # comment ("--") as a command-line flag.
  result=$(hyprctl eval "local _quilt = true
$(cat "$DIR/engine.lua")")
  [[ $result == ok ]] || { notify "Couldn't load the layout engine: $result"; exit 1; }
  result=$(lua 'return quilt.load()')
  [[ $result == ok ]] || { notify "Couldn't start Quilt: $result"; exit 1; }
}

ensure_loaded() {
  [[ $(lua 'return quilt ~= nil and quilt.loaded == true') == true ]] || load
}

# Call an engine function with Lua arguments; report anything but "ok".
call() {
  local result args
  ensure_loaded
  args=$(IFS=,; echo "${*:2}")
  result=$(lua "return quilt.$1($args)")
  [[ $result == ok ]] || { notify "$result"; return 1; }
}

# The Quilt entry in the bar layout, for custom presets.
widget_settings() {
  jq -c --arg id "$ID" 'first(.bar.layout[]?[]? | select(.id == $id)) // {}' "$SHELL_CONFIG" 2>/dev/null || echo '{}'
}

# Built-in presets (only the adaptive ones with builtInPresets: false), then
# the user's own.
presets() {
  local settings
  settings=$(widget_settings)
  jq -r --argjson builtin "$(jq '.builtInPresets != false' <<<"$settings")" \
    '.sections[] | select($builtin or .title == "ADAPTIVE") | .presets[].spec' "$DIR/presets.json"
  jq -r '.presets[]? | if type == "string" then . else .spec end' <<<"$settings"
}

current_spec() {
  ensure_loaded
  lua "local s = quilt.state.workspaces[$(lua_string "$(workspace_key)")] return s and s.spec or ''"
}

# set_spec <spec> [gapsIn] [gapsOut] [apps]: gaps and apps left empty come
# from your preset with this spec, if there is one; "-" for gaps and "{}" for
# apps mean none.
set_spec() {
  local spec=$1 gaps_in=${2:-} gaps_out=${3:-} apps=${4:-} preset
  spec=${spec// /}
  local column='[0-9]+(:[0-9]+(/[0-9]+)*)?' rect='[0-9]+,[0-9]+,[0-9]+,[0-9]+'
  [[ $spec =~ ^(smart|dwindle|scrolling|monocle|off|$column(\|$column)*|@[0-9]+x[0-9]+:$rect(\;$rect)*)$ ]] || {
    notify "\"$1\" isn't a preset Quilt understands"
    exit 1
  }
  # Custom presets can carry their own gaps and app homes. "|" separates the
  # gaps because a space would collapse when only gapsOut is set.
  preset=$(jq -c --arg spec "$spec" 'first(.presets[]? | objects | select((.spec | strings | gsub(" "; "")) == $spec)) // {}' <<<"$(widget_settings)")
  if [[ -z $gaps_in && -z $gaps_out ]]; then
    IFS='|' read -r gaps_in gaps_out < <(jq -r '"\(.gapsIn // "")|\(.gapsOut // "")"' <<<"$preset")
  fi
  [[ -n $apps ]] || apps=$(jq -c '.apps // {}' <<<"$preset")
  [[ -z $gaps_in || $gaps_in =~ ^[0-9]+$ ]] || gaps_in=""
  [[ -z $gaps_out || $gaps_out =~ ^[0-9]+$ ]] || gaps_out=""
  call set "$(lua_string "$(workspace_key)")" "$(lua_string "$spec")" "${gaps_in:-nil}" "${gaps_out:-nil}" "$(lua_homes "$apps")"
}

# One of your presets by label (any case) or spec, with its gaps and apps.
use_preset() {
  local name=$1 preset
  preset=$(jq -c --arg name "$name" '
    [.presets[]? | if type == "string" then { spec: . } else . end | select(.spec | type == "string")] as $all
    | first(($all[] | select((.label // "" | ascii_downcase) == ($name | ascii_downcase))), ($all[] | select((.spec | gsub(" "; "")) == ($name | gsub(" "; ""))))) // empty' <<<"$(widget_settings)")
  [[ -n $preset ]] || { notify "No preset called \"$name\""; exit 1; }
  set_spec "$(jq -r .spec <<<"$preset")" "$(jq -r '.gapsIn // "-"' <<<"$preset")" "$(jq -r '.gapsOut // "-"' <<<"$preset")" "$(jq -c '.apps // {}' <<<"$preset")"
}

cycle() {
  local step=$1 current list i count args=()
  current=$(current_spec)
  # Only presets the engine can use, so a broken one is skipped.
  mapfile -t list < <(presets)
  for i in "${list[@]}"; do args+=("$(lua_string "${i// /}")"); done
  ((${#args[@]} > 0)) || exit 1
  mapfile -t list < <(lua "return quilt.usable($(IFS=,; echo "${args[*]}"))")
  count=${#list[@]}
  ((count > 0)) || exit 1
  for ((i = 0; i < count; i++)); do
    [[ ${list[i]// /} == "$current" ]] && break
  done
  if ((i == count)); then
    i=$((step > 0 ? 0 : count - 1))
  else
    i=$(((i + step + count) % count))
  fi
  set_spec "${list[i]}"
}

check_requirements

case ${1:-} in
load) load ;;
set) [[ -n ${2:-} ]] || usage; set_spec "$2" "${3:-}" "${4:-}" "${5:-}" ;;
off) set_spec off ;;
use) [[ -n ${2:-} ]] || usage; use_preset "$2" ;;
next) cycle 1 ;;
prev) cycle -1 ;;
grow) call grow "$(lua_string "$(workspace_key)")" 1 ;;
shrink) call grow "$(lua_string "$(workspace_key)")" -1 ;;
mirror) call mirror "$(lua_string "$(workspace_key)")" ;;
main) call move "$(lua_string "$(workspace_key)")" "'main'" ;;
move)
  [[ ${2:-} =~ ^([0-9]+|empty|main)$ ]] || usage
  call move "$(lua_string "$(workspace_key)")" "$(lua_string "$2")"
  ;;
target)
  [[ ${2:-} =~ ^[0-9]+$ ]] || usage
  # A drop area on another monitor names its workspace; focus it first so
  # the app opens there.
  if [[ -n ${3:-} ]]; then
    QUILT_WORKSPACE=$3
    hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_string "$3") })" >/dev/null
  fi
  call target "$(lua_string "$(workspace_key)")" "$2" && omarchy-menu summon apps
  ;;
swap)
  [[ ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[0-9]+$ ]] || usage
  call swap "$(lua_string "$(workspace_key)")" "$2" "$3"
  ;;
home)
  [[ -z ${2:-} || $2 =~ ^[0-9]+$ ]] || usage
  call home "$(lua_string "$(workspace_key)")" "${2:-nil}" "$([[ -n ${3:-} ]] && lua_string "$3" || echo nil)"
  ;;
homes)
  if [[ -n ${2:-} ]]; then
    call homes "$(lua_string "$(workspace_key)")" "$(lua_homes "$2")"
  else
    ensure_loaded
    lua "return quilt.status($(lua_string "$(workspace_key)"))" | jq -c .homes
  fi
  ;;
edit) omarchy-shell "$ID" edit ;;
new) omarchy-shell "$ID" create ;;
area)
  ensure_loaded
  lua "return quilt.area($(lua_string "$(workspace_key)"))"
  ;;
status)
  ensure_loaded
  lua "return quilt.status($(lua_string "$(workspace_key)"))"
  ;;
*) usage ;;
esac
